  "issues": {
    "protocol_2014_disabled": {
      "title": "{name}: Schreiben per Modbus ausgeschaltet",
      "description": "Der Kessel beantwortet Schreibzugriffe mit „Illegal Function“. Am Kessel im Servicemenü (Code −7) → MODBUS-Einstellungen „MODBUS-Protokoll 2014 verwenden“ auf JA stellen. Erst danach lassen sich Einstellungen ändern."
    },
    "remote_control_disabled": {
      "title": "{name}: Fernschalten über Fröling Connect ausgeschaltet",
      "description": "Einstellungen lassen sich über Fröling Connect nicht aus Home Assistant ändern; die betroffenen Entitäten sind nicht verfügbar. Am Kessel (Connect-Einstellungen) oder in der Fröling-Connect-App „Fernschalten über connect möglich“ einschalten. Danach verschwindet diese Meldung von selbst."
    }
  },
