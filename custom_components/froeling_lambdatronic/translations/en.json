  "issues": {
    "protocol_2014_disabled": {
      "title": "{name}: Modbus writing disabled",
      "description": "The boiler answers writes with 'Illegal Function'. At the boiler, open service menu (code -7) → MODBUS settings and set 'MODBUS-Protokoll 2014 verwenden' to JA. Settings can only be changed afterwards."
    },
    "remote_control_disabled": {
      "title": "{name}: remote control via Fröling Connect disabled",
      "description": "Settings cannot be changed via Fröling Connect from Home Assistant; the affected entities are unavailable. Enable 'Fernschalten über connect möglich' at the boiler (Connect settings) or in the Fröling Connect app. This message disappears automatically afterwards."
    }
